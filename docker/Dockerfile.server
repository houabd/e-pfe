FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

# ─── Dépendances ─────────────────────────────────────────────────────────────
FROM base AS deps
COPY server/package*.json ./server/
COPY package*.json ./
RUN npm ci --workspace=server --omit=dev

# ─── Build ───────────────────────────────────────────────────────────────────
FROM base AS builder
COPY server/package*.json ./server/
COPY package*.json ./
RUN npm ci --workspace=server

COPY server/ ./server/
RUN npm run build:server

# Génère le client Prisma
RUN cd server && npx prisma generate

# ─── Production ──────────────────────────────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodeuser

COPY --from=builder --chown=nodeuser:nodejs /app/server/dist ./dist
COPY --from=builder --chown=nodeuser:nodejs /app/server/node_modules ./node_modules
COPY --from=builder --chown=nodeuser:nodejs /app/server/prisma ./prisma

RUN mkdir -p uploads && chown nodeuser:nodejs uploads

USER nodeuser

EXPOSE 3001

CMD ["node", "dist/index.js"]
