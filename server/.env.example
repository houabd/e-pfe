# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://epfc_user:epfc_pass@localhost:5432/epfc_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client origin (CORS)
CLIENT_URL=http://localhost:5173

# App config
DEFAULT_SESSION_YEAR=2025-2026

# RAG / Chatbot — Option A : Ollama (local, gratuit)
LLM_API_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# Option B : OpenAI (payant, 1536 dims — nécessite aussi une migration vers vector(1536))
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-real-key
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# File uploads
UPLOAD_MAX_SIZE_MB=50
